# Environment for every zsh (login, interactive, scripts): no aliases, no tool init.
# Sourced by the ~/.zshenv bootstrap on first start, and read directly by nested shells, which
# start with ZDOTDIR already set and therefore never read ~/.zshenv.

# Keep PATH free of duplicates no matter how many nested shells add to it
typeset -U path PATH

# Prefer US English and use UTF-8 (LANG only: LC_ALL would override every category and
# travels over SSH to hosts that may not have this locale)
export LANG='en_US.UTF-8'

# Preferred editor for local and remote sessions
export EDITOR='nvim';

# Enable color support of ls and also add handy aliases
export CLICOLOR=YES

# Do not upgrade homebrew on every install
export HOMEBREW_NO_AUTO_UPDATE=1

# Base directories (XDG Base Directory spec)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"

# fzf default options, rendered by chezmoi for the active theme
export FZF_DEFAULT_OPTS_FILE="$XDG_CONFIG_HOME/fzf/fzfrc"

# Brewfile rendered by chezmoi from packages.yaml, so `brew bundle` works without --file
export HOMEBREW_BUNDLE_FILE="$XDG_CONFIG_HOME/homebrew/Brewfile"
