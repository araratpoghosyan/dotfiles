{{- /*
  herdr keeps its theme in the [theme] table of its single config file, so the active theme's
  asset (the body of that table: a built-in `name`, plus [theme.custom] overrides for palettes
  herdr does not ship) is included here at render time. `herdr --default-config` lists every
  built-in theme and option.

  pane_borders: herdr < 0.9.0 only accepts a boolean and frames a pane only when its tab is split.
  0.9.0 adds "always", which frames a lone pane too. The installed version decides which form is
  rendered; without a herdr binary (CI, first apply) the boolean is used.
*/ -}}
{{- $paneBorders := "true" -}}
{{- if lookPath "herdr" -}}
{{-   $herdrVersion := output "herdr" "--version" | trim | trimPrefix "herdr " -}}
{{-   if semverCompare ">= 0.9.0" $herdrVersion -}}
{{-     $paneBorders = `"always"` -}}
{{-   end -}}
{{- end -}}
# Rendered by chezmoi: base settings plus themes/herdr/{{ .theme }}.toml. Edit the source template, not this file.

[theme]
{{ include (printf .themeAssets.herdr.source .theme) -}}

[ui]
agent_panel_sort = "spaces"

# Pane frames: every pane gets its own frame (accent color when focused), including the outer
# edge, with a one-cell gap between neighbours instead of shared divider lines.
pane_borders = {{ $paneBorders }}
pane_outer_borders = true
pane_gaps = true
