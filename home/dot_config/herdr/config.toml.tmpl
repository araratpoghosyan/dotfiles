{{- /*
  herdr runs on its own defaults (`herdr --default-config` documents them); only the theme is
  ours. The other four keys are ones herdr writes into this file itself: onboarding once the
  first-run setup is dismissed, auto_switch on a manual theme pick in Settings, status_indicators
  and toast delivery when Settings changes them. Without them here every apply would strip them
  and the drift check would flag the file; all but onboarding are the defaults anyway.
*/ -}}
# Rendered by chezmoi: herdr defaults plus themes/herdr/{{ .theme }}.toml. Edit the source template, not this file.

onboarding = false

[theme]
auto_switch = false
{{ include (printf .themeAssets.herdr.source .theme) -}}

[ui]
status_indicators = "dots"

[ui.toast]
delivery = "off"
