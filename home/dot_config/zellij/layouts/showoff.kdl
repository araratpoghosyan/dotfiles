layout {
    tab {
        pane split_direction="vertical" {
            pane {
                cwd "~/.local/share/chezmoi"
                command "nvim"
                args "home/private_dot_config/private_nvim/lua/config/options.lua"
            }
            pane {
                command "fastfetch"
            }
        }
        pane split_direction="vertical" {
            pane {
                cwd "~/.local/share/chezmoi/home"
                command "eza"
                args "--color=always" "--icons=always" "--long" "--header"
            }
            pane {
                command "btop"
            }
        }
    }
}
