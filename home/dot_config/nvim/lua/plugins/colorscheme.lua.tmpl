{{- /*
  LazyVim colorscheme spec, rendered from the `nvim` block of the active theme in
  .chezmoidata/themes.yaml. The plugin is registered under the theme's key; the colorscheme
  command is the key too unless the entry names a different one (plugins that select a variant
  through setup() options rather than a colorscheme file).
*/ -}}
{{- $theme := .theme -}}
{{- $spec := (index .themes $theme).nvim -}}
{{- $light := (index .themes $theme).light -}}
return {
  {
    {{ $spec.repo | quote }},
    name = {{ $theme | quote }},
    priority = 1000,
{{- if hasKey $spec "lazy" }}
    lazy = {{ $spec.lazy }},
{{- end }}
    config = function()
      -- Some plugins never set 'background' (kanagawa, onedark.nvim); lualine and friends read it.
      vim.o.background = {{ ternary "light" "dark" $light | quote }}
{{- if hasKey $spec "module" }}
{{- if hasKey $spec "opts" }}
      require({{ $spec.module | quote }}).setup({
{{- range $key, $value := $spec.opts }}
        {{ $key }} = {{ if kindIs "string" $value }}{{ $value | quote }}{{ else }}{{ $value }}{{ end }},
{{- end }}
      })
{{- else }}
      require({{ $spec.module | quote }}).setup()
{{- end }}
{{- end }}
    end,
  },
  {
    "LazyVim/LazyVim",
    opts = {
      colorscheme = {{ get $spec "colorscheme" | default $theme | quote }},
    },
  },
}
