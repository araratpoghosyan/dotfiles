# Theme
theme = {{ (index .themes .theme).ghostty }}

# Fonts
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15
font-feature = -calt

# Shell configuration
shell-integration-features = "ssh-terminfo,no-cursor"

# Window
window-width = 120
window-height = 30

window-padding-x = 4
window-padding-y = 4

window-padding-balance = true

window-inherit-working-directory = false

# macOS specific settings
macos-option-as-alt = true

# Custom titlebar with the tab bar inside it, painted in the terminal background. The default
# "transparent" style leaves the native tab bar in system colors once a window has several tabs.
# Renders broken on Ghostty 1.3.1 with macOS 27, hence the tip build in packages.yaml.
macos-titlebar-style = tabs

# Cursor
cursor-style = block
cursor-style-blink = false