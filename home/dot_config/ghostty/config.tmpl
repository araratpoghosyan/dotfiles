# Theme
theme = {{ (index .themes .theme).ghostty }}

# Fonts
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15
font-feature = -calt

# Shell configuration
shell-integration-features = "ssh-terminfo,no-cursor"

# Window
window-width = 120
window-height = 30

window-padding-x = 12
window-padding-y = 10

window-padding-balance = true

window-inherit-working-directory = false

# macOS specific settings
macos-option-as-alt = true

# Custom titlebar with the tab bar inside it, painted in the terminal background. The default
# "transparent" style leaves the native tab bar in system colors once a window has several tabs.
# Renders broken on Ghostty 1.3.1 with macOS 27; the tip channel below carries the fix.
macos-titlebar-style = tabs
# Follow pre-release builds from main through Ghostty's own updater. The stable cask from
# packages.yaml is installed once; Sparkle moves it to tip on the first update check, and brew
# never touches a self-updating cask unless asked with --greedy. Needs a full restart to change.
auto-update-channel = tip

# Cursor
cursor-style = block
cursor-style-blink = false