{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "lightBg": "#fafafa",
    "lightBgAlt": "#f0f0f1",
    "lightBgPanel": "#eaeaeb",
    "lightFg": "#383a42",
    "lightFgMuted": "#a0a1a7",
    "lightPurple": "#a626a4",
    "lightBlue": "#4078f2",
    "lightRed": "#e45649",
    "lightGreen": "#50a14f",
    "lightYellow": "#c18401",
    "lightOrange": "#986801",
    "lightCyan": "#0184bc"
  },
  "theme": {
    "primary": "lightBlue",
    "secondary": "lightPurple",
    "accent": "lightCyan",
    "error": "lightRed",
    "warning": "lightYellow",
    "success": "lightGreen",
    "info": "lightOrange",
    "text": "lightFg",
    "textMuted": "lightFgMuted",
    "background": "lightBg",
    "backgroundPanel": "lightBgAlt",
    "backgroundElement": "lightBgPanel",
    "border": "#d1d1d2",
    "borderActive": "lightBlue",
    "borderSubtle": "#e0e0e1",
    "diffAdded": "lightGreen",
    "diffRemoved": "lightRed",
    "diffContext": "lightFgMuted",
    "diffHunkHeader": "lightCyan",
    "diffHighlightAdded": "#489447",
    "diffHighlightRemoved": "#d65145",
    "diffAddedBg": "#eafbe9",
    "diffRemovedBg": "#fce9e8",
    "diffContextBg": "lightBgAlt",
    "diffLineNumber": "#666666",
    "diffAddedLineNumberBg": "#e1f3df",
    "diffRemovedLineNumberBg": "#f5e2e1",
    "markdownText": "lightFg",
    "markdownHeading": "lightPurple",
    "markdownLink": "lightBlue",
    "markdownLinkText": "lightCyan",
    "markdownCode": "lightGreen",
    "markdownBlockQuote": "lightFgMuted",
    "markdownEmph": "lightYellow",
    "markdownStrong": "lightOrange",
    "markdownHorizontalRule": "lightFgMuted",
    "markdownListItem": "lightBlue",
    "markdownListEnumeration": "lightCyan",
    "markdownImage": "lightBlue",
    "markdownImageText": "lightCyan",
    "markdownCodeBlock": "lightFg",
    "syntaxComment": "lightFgMuted",
    "syntaxKeyword": "lightPurple",
    "syntaxFunction": "lightBlue",
    "syntaxVariable": "lightRed",
    "syntaxString": "lightGreen",
    "syntaxNumber": "lightOrange",
    "syntaxType": "lightYellow",
    "syntaxOperator": "lightCyan",
    "syntaxPunctuation": "lightFg"
  }
}
