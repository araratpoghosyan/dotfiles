# ayu mirage for btop, built from the official palette: https://github.com/ayu-theme/ayu-colors (MIT).
# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1f2430"

# Main text color
theme[main_fg]="#cccac2"

# Title color for boxes
theme[title]="#cccac2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffcc66"

# Background color of selected item in processes box
theme[selected_bg]="#274364"

# Foreground color of selected item in processes box
theme[selected_fg]="#cccac2"

# Color of inactive/disabled text
theme[inactive_fg]="#6c7a8b"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#cccac2"

# Background color of the percentage meters
theme[meter_bg]="#171b24"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#73d0ff"

# Cpu box outline color
theme[cpu_box]="#171b24"

# Memory/disks box outline color
theme[mem_box]="#171b24"

# Net up/down box outline color
theme[net_box]="#171b24"

# Processes box outline color
theme[proc_box]="#171b24"

# Box divider line and small boxes line color
theme[div_line]="#171b24"

# Temperature graph colors
theme[temp_start]="#d5ff80"
theme[temp_mid]="#ffcc66"
theme[temp_end]="#f28779"

# CPU graph colors
theme[cpu_start]="#d5ff80"
theme[cpu_mid]="#ffcc66"
theme[cpu_end]="#f28779"

# Mem/Disk free meter
theme[free_start]="#73d0ff"
theme[free_mid]="#5ccfe6"
theme[free_end]="#d5ff80"

# Mem/Disk cached meter
theme[cached_start]="#73d0ff"
theme[cached_mid]="#5ccfe6"
theme[cached_end]="#d5ff80"

# Mem/Disk available meter
theme[available_start]="#73d0ff"
theme[available_mid]="#5ccfe6"
theme[available_end]="#d5ff80"

# Mem/Disk used meter
theme[used_start]="#d5ff80"
theme[used_mid]="#ffcc66"
theme[used_end]="#f28779"

# Download graph colors
theme[download_start]="#5ccfe6"
theme[download_mid]="#73d0ff"
theme[download_end]="#dfbfff"

# Upload graph colors
theme[upload_start]="#d5ff80"
theme[upload_mid]="#ffcc66"
theme[upload_end]="#ffad66"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#73d0ff"
theme[process_mid]="#dfbfff"
theme[process_end]="#f28779"
