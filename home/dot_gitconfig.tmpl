{{- $activeTheme := index .themes .theme -}}
[user]
  name = {{ .fullName }}
  email = {{ .email }}

[core]
  autocrlf = input
  excludesfile = ~/.gitignore
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true    # use n and N to move between diff sections
  light = {{ $activeTheme.light }}      # derived from the selected theme's light flag in .chezmoidata/themes.yaml
  side-by-side = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default
