# Initialize chezmoi
if command -v chezmoi &>/dev/null; then
    eval "$(chezmoi completion zsh)"
fi

# Initialize zoxide
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init --cmd cd zsh)"
fi

# Initialize mise
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# Configure lazygit
if command -v lazygit &>/dev/null; then
    export LG_CONFIG_FILE="$XDG_CONFIG_HOME/lazygit/config.yml,$XDG_CONFIG_HOME/lazygit/themes/catppuccin-{{ .theme }}.yml"
fi

# Initialize fzf
if command -v fzf &>/dev/null; then
    show_file_or_dir_preview="if [ -d {} ]; then eza --tree --color=always {} | head -200; else bat -n --color=always --line-range :500 {}; fi"

    export FZF_CTRL_T_OPTS="--preview '$show_file_or_dir_preview'"
    export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

    _fzf_comprun() {
      local command=$1
      shift

      case "$command" in
        cd)           fzf --preview 'eza --tree --color=always {} | head -200' "$@" ;;
        export|unset) fzf --preview "eval 'echo ${}'"         "$@" ;;
        ssh)          fzf --preview 'dig {}'                   "$@" ;;
        *)            fzf --preview "$show_file_or_dir_preview" "$@" ;;
      esac
    }

    # Set FZF color theme
    source "$XDG_CONFIG_HOME/fzf/themes/catppuccin-fzf-{{ .theme }}.sh"

    FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS $FZF_THEME"

    source <(fzf --zsh)
fi

# Configure eza
if command -v eza &>/dev/null; then
    export EZA_CONFIG_DIR="$XDG_CONFIG_HOME/eza"
    export EZA_COLORS_FILE="$XDG_CONFIG_HOME/eza/themes/catppuccin-{{ .theme }}.yml"

    # Aliases for eza
    alias ls="eza --color=always --icons=always"
    alias ll="eza --color=always --icons=always --long --header"
    alias la="eza --color=always --icons=always --long --header --all"
    alias lt="eza --color=always --icons=always --tree"
fi

# Configure neovim
if command -v nvim &>/dev/null; then
    alias vim="nvim"
fi

# Configure bat
if command -v bat &>/dev/null; then
    alias cat="bat"
fi

# Configure yazi
if command -v yazi &>/dev/null; then
    alias y="yazi"
fi

# Configure uuidgen
if command -v uuidgen &>/dev/null; then
    alias uuid="uuidgen | tr \"[:upper:]\" \"[:lower:]\""
fi
