{{- /*
  Deploy only the active theme. The tool assets of every other registered theme are ignored,
  so ~/.config carries one theme per tool. chezmoi never removes an ignored target, so after a
  theme switch the previous theme's files are cleaned up by
  .chezmoiscripts/run_onchange_after_prune-inactive-themes.sh.tmpl.
*/ -}}
{{- range $name, $_ := .themes }}
{{-   if ne $name $.theme }}
{{-     range $tool, $asset := $.themeAssets }}
{{-       if hasKey $asset "target" }}
{{ printf $asset.target $name }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
