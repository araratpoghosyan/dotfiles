{{- /*
  Deploy only the active theme. The tool assets of every other registered theme are ignored,
  so ~/.config carries one theme per tool. chezmoi never removes an ignored target, so after a
  theme switch the previous theme's files are cleaned up by
  .chezmoiscripts/run_onchange_after_50-prune-inactive-themes.sh.tmpl.
*/ -}}
{{- range $name, $_ := .themes }}
{{-   if ne $name $.theme }}
{{-     range $tool, $asset := $.themeAssets }}
{{-       if hasKey $asset "target" }}
{{ printf $asset.target $name }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}

{{- /*
  1Password-backed files. Ignored entries are never rendered, so chezmoi makes no 1Password call
  when no account is configured, or when the CLI is not installed yet (first apply on a new
  machine, before Homebrew has installed 1Password). They appear on the next apply once `op` exists.
*/ -}}
{{- if or (not .onePasswordAccount) (not (lookPath "op")) }}
.ssh/config
{{- end }}
