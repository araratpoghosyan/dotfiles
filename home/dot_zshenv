# Bootstrap only. zsh reads this file just once, in the first shell of a session; every nested shell
# starts with ZDOTDIR already exported and reads $ZDOTDIR/.zshenv instead. Keeping the real
# environment there means both paths run the same code.
export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
[ -r "$ZDOTDIR/.zshenv" ] && source "$ZDOTDIR/.zshenv"
