#!/bin/bash

# Runs on every `chezmoi apply` so packages.yaml is always the source of truth.
# `brew bundle check` keeps the common no-op case fast; the slow install path
# only runs when something is actually missing.

set -eufo pipefail

if ! command -v brew &>/dev/null; then
    echo "⚠️  Homebrew is not installed yet. Skipping package installation."
    exit 0
fi

# Homebrew refuses to load formulae/casks from untrusted third-party taps, which
# aborts the whole bundle run. Trust exactly the taps declared in packages.yaml.
{{ range .packages.taps -}}
brew trust --tap {{ . | quote }} >/dev/null
{{ end }}
BREWFILE="$(mktemp -t Brewfile)"
trap 'rm -f "$BREWFILE"' EXIT

cat >"$BREWFILE" <<'EOF'
{{ range .packages.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

if brew bundle check --file="$BREWFILE" --no-upgrade &>/dev/null; then
    echo "✅ Homebrew packages already up to date"
else
    echo "🍺 Installing missing Homebrew packages..."
    brew bundle install --file="$BREWFILE" --no-upgrade
fi

{{ if .packages.mas -}}
if ! command -v mas &>/dev/null; then
    echo "⚠️  mas is not installed yet. Skipping Mac App Store apps."
    exit 0
fi

installed_mas="$(mas list | awk '{print $1}')"
{{ range .packages.mas }}
if ! grep -qx {{ .id | quote }} <<<"$installed_mas"; then
    echo "🍎 Installing {{ .name }} ({{ .id }})..."
    mas install {{ .id }}
fi
{{ end -}}
{{ end -}}

echo "✅ Package installation complete"
