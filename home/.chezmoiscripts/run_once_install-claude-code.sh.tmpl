#!/bin/bash

{{ if eq .chezmoi.os "darwin" -}}

set -eufo pipefail

if command -v claude &>/dev/null; then
    echo "✅ Claude Code is already installed"
    exit 0
fi

echo "📦 Installing Claude Code..."

curl -fsSL https://claude.ai/install.sh | bash

echo "✅ Claude Code installation complete"

{{ end -}}
