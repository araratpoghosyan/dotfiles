#!/bin/bash

# This script rebuilds the bat cache after bat configuration changes.
# It runs automatically when bat config or themes are modified.

# Hash of bat config and theme contents to trigger re-runs when changed
# bat config hash: {{ include "private_dot_config/private_bat/config.tmpl" | sha256sum }}
{{- range glob (joinPath .chezmoi.sourceDir "private_dot_config/private_bat/themes/*.tmTheme") }}
# {{ base . }} hash: {{ include . | sha256sum }}
{{- end }}

set -eufo pipefail

echo "🦇 Rebuilding bat cache..."

# Check if bat is installed
if ! command -v bat &>/dev/null; then
    echo "⚠️  bat is not installed yet. Skipping cache rebuild."
    exit 0
fi

# Rebuild bat cache to include custom themes
bat cache --build

echo "✅ bat cache rebuilt successfully"
