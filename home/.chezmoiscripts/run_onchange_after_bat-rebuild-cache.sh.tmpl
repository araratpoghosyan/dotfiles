#!/bin/bash

# This script rebuilds the bat cache after bat configuration changes.
# It runs automatically when bat config or themes are modified.

# Hash of bat config to trigger re-runs when changed
# bat config hash: {{ include "private_dot_config/private_bat/config.tmpl" | sha256sum }}
# bat themes hash: {{ include "private_dot_config/private_bat/themes/catppuccin-frappe.tmTheme" | sha256sum }}
# bat themes hash: {{ include "private_dot_config/private_bat/themes/catppuccin-latte.tmTheme" | sha256sum }}
# bat themes hash: {{ include "private_dot_config/private_bat/themes/catppuccin-macchiato.tmTheme" | sha256sum }}
# bat themes hash: {{ include "private_dot_config/private_bat/themes/catppuccin-mocha.tmTheme" | sha256sum }}

set -eufo pipefail

echo "🦇 Rebuilding bat cache..."

# Check if bat is installed
if ! command -v bat &>/dev/null; then
    echo "⚠️  bat is not installed yet. Skipping cache rebuild."
    exit 0
fi

# Rebuild bat cache to include custom themes
bat cache --build

echo "✅ bat cache rebuilt successfully"
