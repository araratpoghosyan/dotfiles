#!/bin/bash

# Runs on every `chezmoi apply` (deliberately not run_onchange) so packages.yaml stays the source
# of truth even after something was uninstalled by hand. `brew bundle check` keeps the common
# no-op case fast; the slow install path only runs when something is missing.
# The Brewfile is a managed file rendered from packages.yaml (see ~/.config/homebrew/Brewfile),
# which is why this script runs in the `after` phase.

set -eufo pipefail

BREWFILE="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile"

if ! command -v brew &>/dev/null; then
    echo "⚠️  Homebrew is not installed yet. Skipping package installation."
    exit 0
fi

# Homebrew refuses to load formulae/casks from untrusted third-party taps, which
# aborts the whole bundle run. Trust exactly the taps declared in packages.yaml.
{{ range .packages.taps -}}
brew trust --tap {{ . | quote }} >/dev/null
{{ end }}
if brew bundle check --file="$BREWFILE" --no-upgrade &>/dev/null; then
    echo "✅ Homebrew packages already up to date"
else
    echo "🍺 Installing missing packages from $BREWFILE..."
    # Formulae, casks and taps must succeed. App Store entries need an App Store sign-in that a
    # fresh machine may not have yet, so they are installed separately and may fail without
    # failing the apply; `brew bundle --file=-` reads a Brewfile from stdin.
    grep -v '^mas ' "$BREWFILE" | brew bundle install --file=- --no-upgrade
    if grep -q '^mas ' "$BREWFILE"; then
        grep '^mas ' "$BREWFILE" | brew bundle install --file=- --no-upgrade ||
            echo "⚠️  App Store apps skipped: sign in to the App Store and run chezmoi apply again"
    fi
fi

echo "✅ Package installation complete"
