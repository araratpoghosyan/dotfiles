#!/bin/bash

# This script rebuilds the bat cache after bat configuration changes.
# It runs automatically when the bat config or the active theme file changes.

# Re-runs when the deployed theme file changes (bat cache --build reads themes only, not the config)
# active theme ({{ .theme }}) hash: {{ include (printf .themeAssets.bat.source .theme) | sha256sum }}

set -eufo pipefail

echo "🦇 Rebuilding bat cache..."

# Check if bat is installed
if ! command -v bat &>/dev/null; then
    echo "⚠️  bat is not installed yet. Skipping cache rebuild."
    exit 0
fi

# Rebuild bat cache to include custom themes
bat cache --build

echo "✅ bat cache rebuilt successfully"
