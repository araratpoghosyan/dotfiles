#!/bin/bash
# This script runs before chezmoi apply to ensure .chezmoi.toml exists

set -e

CHEZMOI_SOURCE_DIR="{{ .chezmoi.sourceDir }}"
CONFIG_FILE="${CHEZMOI_SOURCE_DIR}/.chezmoi.toml"
EXAMPLE_FILE="${CHEZMOI_SOURCE_DIR}/.chezmoi.toml.example"

# Check if .chezmoi.toml exists
if [ ! -f "${CONFIG_FILE}" ]; then
    echo ""
    echo "❌ ERROR: Configuration file not found!"
    echo ""
    echo "The file '.chezmoi.toml' is required but does not exist."
    echo ""
    echo "To fix this:"
    echo "  1. Copy the example configuration:"
    echo "     cp ${EXAMPLE_FILE} ${CONFIG_FILE}"
    echo ""
    echo "  2. Edit the file with your personal information:"
    echo "     \${EDITOR} ${CONFIG_FILE}"
    echo ""
    echo "  3. Update at least these fields:"
    echo "     - theme (choose from available themes)"
    echo "     - name (your name)"
    echo "     - fullName (your full name)"
    echo "     - email (your email address)"
    echo ""
    echo "  4. Then run chezmoi apply again"
    echo ""
    exit 1
fi

# Optional: Validate that required fields are not using example values
if grep -q "Your Name" "${CONFIG_FILE}" || grep -q "your.email@example.com" "${CONFIG_FILE}"; then
    echo ""
    echo "⚠️  WARNING: It looks like you're still using example values in .chezmoi.toml"
    echo ""
    echo "Please update the following fields with your actual information:"
    echo "  - name"
    echo "  - fullName"
    echo "  - email"
    echo ""
    echo "Edit the file: \${EDITOR} ${CONFIG_FILE}"
    echo ""
    echo "Press Enter to continue anyway, or Ctrl+C to cancel..."
    read -r
fi

exit 0
