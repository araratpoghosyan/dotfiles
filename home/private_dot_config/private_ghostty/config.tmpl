# Theme
{{ if eq .theme "catppuccin-frappe" }}
theme = Catppuccin Frappe
{{ else if eq .theme "catppuccin-macchiato" }}
theme = Catppuccin Macchiato
{{ else if eq .theme "catppuccin-mocha" }}
theme = Catppuccin Mocha
{{else if eq .theme "catppuccin-latte" }}
theme = Catppuccini Latte
{{else if eq .theme "dracula" }}
theme = Dracula
{{else if eq .theme "tokyonight-day" }}
theme = TokyoNight Day
{{else if eq .theme "tokyonight-moon" }}
theme = TokyoNight Moon
{{else if eq .theme "tokyonight-night" }}
theme = TokyoNight Night
{{else if eq .theme "tokyonight-storm" }}
theme = TokyoNight Storm
{{else if eq .theme "0x96f" }}
theme = 0x96f
{{ end }}

# Fonts
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15
adjust-cell-height = 6
font-feature = -calt

# Shell configuration
shell-integration-features = "ssh-terminfo"

# Window
window-padding-x = 8
window-padding-y = 4

window-width = 120
window-height = 30

window-inherit-working-directory = false

# macOS specific settings
macos-titlebar-style = "native"
macos-option-as-alt = true

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
